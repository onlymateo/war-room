# WAR ROOM — optional environment overrides. Copy to .env if needed.
# Port of the local API server (the UI dev server proxies /api to it).
WARROOM_PORT=4317
# Where the SQLite database, uploaded files and the master key live.
WARROOM_DATA_DIR=./data
# Optional: provide the 32-byte master key (base64) instead of the generated data/master.key file.
# WARROOM_MASTER_KEY=
